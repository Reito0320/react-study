{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "prisma.config.ts"
  ]
}
